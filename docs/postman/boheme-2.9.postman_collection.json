            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Vendedor demo 2.9\",\n  \"correo\": \"vendedor.{{runId}}@boheme.test\",\n  \"password\": \"DemostracionBoheme2026!\",\n  \"rol\": \"VENDEDOR\"\n}",
